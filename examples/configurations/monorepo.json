{
  "description": "Configuration for a monorepo with multiple packages",
  "packages": [
    "./packages/*",
    "./libs/*",
    "./tools/*"
  ],
  "scope_aliases": {
    "apps": [
      "package:packages"
    ],
    "libs": [
      "package:libs"
    ],
    "tools": [
      "package:tools"
    ]
  },
  "scope_defaults": {
    "global": "all"
  }
}
