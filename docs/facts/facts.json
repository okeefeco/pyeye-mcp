    "project.python_versions": [
      "3.11",
      "3.12",
      "3.13",
      "3.14"
    ],
    "project.requires_python": ">=3.11",
    "resolver.bare_name.exact_module": {
      "position": 2,
      "summary": "a complete top-level module (the project's package, a namespace root or an external module) wins over same-named definitions"
    },
    "resolver.bare_name.members": {
      "position": 4,
      "summary": "only when nothing above matched, every method or class attribute with that name, decided the same way; dunder names never match"
    },
    "resolver.bare_name.name_index": {
      "position": 3,
      "summary": "every project definition with that name, canonicalised: one is the answer, several are ambiguous"
    },
    "resolver.bare_name.shadow": {
      "position": 1,
      "summary": "a top-level package or module under more than one project root is ambiguous"
    },
    "resolver.strategy.definition_placement": {
      "position": 1,
      "side": "project",
      "summary": "the definition in the deepest project module along the path, following a re-export alias to its definition, with no fallback to shallower modules"
    },
    "resolver.strategy.external_definition": {
      "position": 3,
      "side": "external",
      "summary": "a definition at exactly the requested path, found by goto"
    },
    "resolver.strategy.external_module": {
      "position": 2,
      "side": "external",
      "summary": "a stdlib or site-packages module, through a Jedi import"
    },
    "resolver.strategy.guarded_inference": {
      "position": 4,
      "side": "external",
      "summary": "an inferred definition, accepted only if its name equals the last component"
    },
    "resolver.strategy.namespace_package": {
      "position": 2,
      "side": "all",
      "summary": "a PEP 420 namespace package: a directory with importable content and no init file"
    },
    "resolver.strategy.private_stdlib": {
      "position": 1,
      "side": "external",
      "summary": "a stdlib definition in a private module, named by its public re-exporting module"
    },
    "resolver.strategy.project_module": {
      "position": 1,
      "side": "all",
      "summary": "a project module, as a package or a single file"
    },
    "review.axis.cross_cutting": {
      "description": "Cross-cutting access: logging, config, path handling.",
      "facets": [
        "logging",
        "config_access",
        "path_handling"
      ],
      "stakes_bucket": "med",
      "stakes_prior": 0.5
    },
    "review.axis.dependency_acquisition": {
      "description": "Dependency acquisition: constructor-injection vs import vs global/singleton.",
      "facets": [
        "injection",
        "global_singleton",
        "import_time_construction"
      ],
      "stakes_bucket": "med",
      "stakes_prior": 0.6
    },
    "review.axis.error_handling": {
      "description": "Error handling: raise vs return-sentinel vs result-type; exception types; where caught.",
      "facets": [
        "raise_vs_sentinel",
        "exception_types",
        "catch_site"
      ],
      "stakes_bucket": "high",
      "stakes_prior": 0.9
    },
    "review.axis.layering": {
      "description": "Layering / dependency direction: which layers/packages may import which.",
      "facets": [
        "import_direction",
        "layer_skip",
        "import_cycle"
      ],
      "stakes_bucket": "med",
      "stakes_prior": 0.7
    },
    "review.axis.module_boundaries": {
      "description": "Module & placement boundaries: where a *kind* of thing lives.",
      "facets": [
        "placement",
        "module_split",
        "public_surface"
      ],
      "stakes_bucket": "med",
      "stakes_prior": 0.6
    },
    "review.axis.naming_api_shape": {
      "description": "Naming & API shape: naming patterns, return-type conventions, sync/async split.",
      "facets": [
        "name_pattern",
        "sync_async",
        "return_shape"
      ],
      "stakes_bucket": "low",
      "stakes_prior": 0.3
    },
    "review.axis.validation_placement": {
      "description": "Validation placement: at the boundary vs in core vs scattered.",
      "facets": [
        "boundary_vs_core",
        "duplicated_check",
        "missing_check"
      ],
      "stakes_bucket": "high",
      "stakes_prior": 0.9
    },
    "review.grade.ambiguous": {
      "tier": 0
    },
    "review.grade.deterministic_single": {
      "tier": 1
    },
    "review.grade.mechanical_fact": {
      "tier": 1
    },
    "review.grade.no_signal": {
      "tier": 2
    },
    "scope.default.plugin": {
      "fallback": "main",
      "order": [
        "scope_defaults.methods.<tool name>",
        "scope_defaults.global"
      ]
    },
    "scope.option.all": {
      "meaning": "the main project, every configured package and namespace, and the standalone directories",
      "syntax": "all"
    },
    "scope.option.main": {
      "meaning": "the main project",
      "syntax": "main"
    },
    "scope.option.namespace": {
      "meaning": "one namespace's package directories; namespace:a.b resolves under namespace a",
      "syntax": "namespace:<name>"
    },
    "scope.option.package": {
      "meaning": "that directory, if it exists: an absolute path, or one relative to the project (project_path)",
      "syntax": "package:<path>"
    },
    "scope.option.packages": {
      "meaning": "the configured packages only",
      "syntax": "packages"
    },
    "scope.option.standalone": {
      "meaning": "the standalone script directories: those in the config's standalone.dirs, for scripts that aren't in any package",
      "syntax": "standalone"
    },
