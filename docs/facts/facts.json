    },
    "scope.option.all": {
      "meaning": "the main project, every configured package and namespace, and the standalone directories",
      "syntax": "all"
    },
    "scope.option.main": {
      "meaning": "the main project",
      "syntax": "main"
    },
    "scope.option.namespace": {
      "meaning": "one namespace's package directories; namespace:a.b resolves under namespace a",
      "syntax": "namespace:<name>"
    },
    "scope.option.package": {
      "meaning": "that directory, if it exists",
      "syntax": "package:<path>"
    },
    "scope.option.packages": {
      "meaning": "the configured packages only",
      "syntax": "packages"
    },
    "scope.option.standalone": {
      "meaning": "the standalone script directories",
      "syntax": "standalone"
    },
