{
  "facts": {
    "ceiling.declared_bases": {
      "meaning": "the bases written in the class statement; bases added at runtime are not included, and bases that don't resolve are listed in unresolved_superclasses"
    },
    "ceiling.literal_subclassing": {
      "meaning": "project classes whose class statement names this class as a base; classes built with type(), class factories or __init_subclass__ registration are not included"
    },
    "ceiling.on_disk_modules": {
      "meaning": "modules and subpackages present on disk under the package; entries added to __path__ at runtime are not included"
    },
    "ceiling.package_reexports": {
      "meaning": "import bindings written in source in the public modules of the symbol's own package (#712); re-exports from other packages and names provided lazily by a module __getattr__ are not included"
    },
    "ceiling.static_calls": {
      "meaning": "calls whose target static analysis resolves; dynamic calls are counted in unresolved_call_sites, not listed"
    },
    "ceiling.static_definitions": {
      "meaning": "definitions written in source: a class body (methods, nested classes, class-level assignments) or a module's top level. Instance attributes assigned in methods (self.x = ...) and anything injected at runtime (metaclass, setattr, __getattr__, type(), __init_subclass__) are not included"
    },
    "ceiling.static_imports": {
      "meaning": "import statements written in source; importlib / __import__ with a computed name is not included"
    },
    "ci.coverage_threshold": 85,
    "ci.python_versions": [
      "3.11",
      "3.12",
      "3.13",
      "3.14"
    ],
    "cli.module.pyeye.mcp": {
      "command": "python -m pyeye.mcp"
    },
    "cli.script.pyeye-mcp": {
      "target": "pyeye.mcp.__main__:main"
    },
    "edge.callees": {
      "applies_to": [
        "function",
        "method"
      ],
      "ceiling": "static_calls",
      "status": "implemented"
    },
    "edge.callers": {
      "status": "deferred_reference_backend"
    },
    "edge.decorated_by": {
      "status": "deferred_reference_backend"
    },
    "edge.decorates": {
      "status": "deferred_reference_backend"
    },
    "edge.enclosing_scope": {
      "applies_to": [
        "attribute",
        "class",
        "enum_member",
        "function",
        "method",
        "property",
        "variable"
      ],
      "ceiling": null,
      "status": "implemented"
    },
    "edge.imported_by": {
      "applies_to": [
        "module"
      ],
      "ceiling": "static_imports",
      "status": "implemented"
    },
    "edge.imports": {
      "applies_to": [
        "module"
      ],
      "ceiling": "static_imports",
      "status": "implemented"
    },
    "edge.members": {
      "applies_to": [
        "class",
        "module"
      ],
      "ceiling": "static_definitions",
      "status": "implemented"
    },
    "edge.overridden_by": {
      "status": "deferred_reference_backend"
    },
    "edge.overrides": {
      "status": "deferred_reference_backend"
    },
    "edge.passed_by": {
      "status": "deferred_reference_backend"
    },
    "edge.re_exports": {
      "applies_to": [
        "attribute",
        "class",
        "enum_member",
        "function",
        "method",
        "property",
        "variable"
      ],
      "ceiling": "package_reexports",
      "status": "implemented"
    },
    "edge.read_by": {
      "status": "deferred_reference_backend"
    },
    "edge.references": {
      "status": "deferred_reference_backend"
    },
    "edge.subclasses": {
      "applies_to": [
        "class"
      ],
      "ceiling": "literal_subclassing",
      "status": "implemented"
    },
    "edge.submodules": {
      "applies_to": [
        "module"
      ],
      "ceiling": "on_disk_modules",
      "status": "implemented"
    },
    "edge.superclasses": {
      "applies_to": [
        "class"
      ],
      "ceiling": "declared_bases",
      "status": "implemented"
    },
    "edge.written_by": {
      "status": "deferred_reference_backend"
    },
