{
  "facts": {
    "cli.module.app": {
      "command": "python -m app"
    },
    "cli.script.demo": {
      "target": "app.cli:main"
    },
    "demo.backends": [
      "memory",
      "disk"
    ],
    "demo.region": "ap-southeast-2",
    "demo.requires_python": ">=3.11",
    "demo.timeout": 30,
    "demo.workers": 4
  },
  "views": {
    "cli.all": [
      "cli.script.demo",
      "cli.module.app"
    ]
  }
}
